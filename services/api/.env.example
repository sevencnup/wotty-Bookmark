BIND_ADDR=127.0.0.1:26626
RUST_LOG=bookmark_vault_api=info,tower_http=info
# 可选：不填写时，程序自动使用当前工作目录下的 data/bookmark-vault.sqlite
# DATABASE_URL=sqlite:///absolute/path/to/bookmark-vault.sqlite?mode=rwc
DATA_DIR=./data
# Comma-separated exact browser origins. Leave empty when the admin UI is served by Caddy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
