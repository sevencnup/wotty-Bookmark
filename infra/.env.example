# Copy to a local .env file outside version control and replace every placeholder.
POSTGRES_DB=bookmark_vault
POSTGRES_USER=bookmark_vault
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode reserved characters in the password before placing it in this URL.
DATABASE_URL=postgres://bookmark_vault:replace-with-a-long-random-password@postgres:5432/bookmark_vault
BIND_ADDR=0.0.0.0:8080
RUST_LOG=bookmark_vault_api=info,tower_http=info
DATA_DIR=/var/lib/bookmark-vault
# Use the public HTTPS origin served by Caddy; do not use *.
CORS_ALLOWED_ORIGINS=https://bookmarks.example.com
BOOKMARK_VAULT_DOMAIN=bookmarks.example.com
HTTP_PORT=80
HTTPS_PORT=443
