{$BOOKMARK_VAULT_DOMAIN:localhost} {
  # Keep API/WebDAV/health routes ahead of the SPA fallback. Caddy sorts
  # top-level directives, so an explicit route block is required here.
  route {
    handle /api/* {
      reverse_proxy api:26626
    }

    handle /dav/* {
      reverse_proxy api:26626
    }

    handle /health/* {
      reverse_proxy api:26626
    }

    handle {
      root * /srv/admin-web
      try_files {path} /index.html
      file_server
    }
  }
}
